{
  "name": "cusa-member-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "install:plesk": "node install.mjs",
    "install:web": "node install.mjs --web",
    "worker:once": "node cron.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write src server shared tests vite.config.ts playwright.config.ts install.mjs app.cjs cron.cjs scripts/config-info.mjs",
    "format:check": "prettier --check src server shared tests vite.config.ts playwright.config.ts install.mjs app.cjs cron.cjs scripts/config-info.mjs",
    "config:models": "node scripts/config-info.mjs models",
    "config:rich-menus": "node scripts/config-info.mjs rich-menus"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@line/liff": "^2.31.1",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^1.52.0",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
