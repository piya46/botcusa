# Local demo: synthetic data, simulated LINE delivery. Never connect live credentials here.
APP_MODE=demo
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5180
DATA_DIR=.data

# Every variable and its source: docs/ENVIRONMENT.md
# Plesk: use install.mjs to generate a private live .env.
# Live requires MySQL 8.0.17+ / MariaDB 10.6+ (or PostgreSQL+pgvector), HTTPS,
# a 32-byte base64 encryption key and CUSA SSO credentials.
# APP_MODE=live
# HOST=0.0.0.0
# APP_ORIGIN=https://bot.reunion.scicu-alumni.com
# DATABASE_URL=mysql://DB_USER:URL_ENCODED_PASSWORD@localhost:3306/DB_NAME
# This Plesk host uses local MySQL without a CA file; leave MYSQL_SSL_CA empty.
# Optional TLS on other hosts: add ?ssl=true; a custom CA is only needed if required by the provider.
# MYSQL_SSL_CA=
# No local cron: scheduled work waits for application wake-up when idle.
# WORKER_MODE=opportunistic
# DATA_ENCRYPTION_KEY=GENERATE_WITH_openssl_rand_-base64_32
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_LOGIN_CHANNEL_ID=
# LIFF_ID=
# LINE_MEMBER_RICH_MENU_ID=
# LINE_GUEST_RICH_MENU_ID=
# LINE_AGENT_ALERT_USER_ID=
# LINE_SUPERVISOR_ALERT_USER_ID=
# Transfer notifications: configure each staff LINE User ID in Workspace Settings.
# Loading animation while the bot searches/thinks, 5–60 seconds in increments of 5.
LINE_LOADING_ENABLED=true
LINE_LOADING_SECONDS=30
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_EMBEDDING_MODEL=
# Analyze closed or idle conversations using GEMINI_MODEL in live mode only.
# Sends a bounded transcript with basic identifier masking; internal notes are excluded.
AI_ANALYTICS_ENABLED=false
# Staff login: application role codes admin / agent / reviewer (case-sensitive).
# Backend key requires identity:read, token:introspect and token:revoke.
# Staff sessions refresh automatically for up to 8 hours, bounded by CUSA MFA/key expiry.
# Refresh tokens stay encrypted in the database, never in this file.
# Register one callback /api/auth/callback for both staff login and LINE member linking.
# CUSA_SSO_ORIGIN=https://sso.reunion.scicu-alumni.com
# CUSA_CLIENT_ID=
# CUSA_API_KEY=
CHAT_RETENTION_DAYS=180
DATASET_RETENTION_DAYS=180
